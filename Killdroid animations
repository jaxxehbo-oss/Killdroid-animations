local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local physicsLoop, armJointLoop, flightMoveLoop, descentLoop
local isFlying = false
local flightForce, flightAttachment, targetPlayer, targetDecal
local reachedPeakAltitude = false
local landingActive = false
local landingTime = 0
local LAND_DURATION = 0.4 
local currentTrack = nil
local wasMidAir = false
local armLiftProgress = 0

local LOCKON_IMAGE_ID = "rbxassetid://9073155799" 

local function getClosestPlayer(rootPart)
	local closest = nil
	local shortestDistance = math.huge
	if not rootPart then return nil end
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
			local distance = (rootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
			if distance < shortestDistance then
				shortestDistance = distance
				closest = p.Character
			end
		end
	end
	return closest
end

local function clearTargetDecal()
	if targetDecal then
		targetDecal:Destroy()
		targetDecal = nil
	end
end

local function applyTargetDecal(characterModel)
	clearTargetDecal()
	local head = characterModel:FindFirstChild("Head")
	if not head then return end
	targetDecal = Instance.new("Decal")
	targetDecal.Name = "KilldroidLockonDecal"
	targetDecal.Texture = LOCKON_IMAGE_ID
	targetDecal.Face = Enum.NormalId.Front 
	targetDecal.Parent = head
end

local function initializeEngine(character)
	if physicsLoop then physicsLoop:Disconnect(); physicsLoop = nil end
	if armJointLoop then armJointLoop:Disconnect(); armJointLoop = nil end
	if flightMoveLoop then flightMoveLoop:Disconnect(); flightMoveLoop = nil end
	if descentLoop then descentLoop:Disconnect(); descentLoop = nil end
	clearTargetDecal()
	isFlying = false
	reachedPeakAltitude = false

	local Humanoid = character:WaitForChild("Humanoid")
	local RootPart = character:WaitForChild("HumanoidRootPart")

	local Torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso") or character:FindFirstChild("LowerTorso")
	local RightShoulder = Torso and (Torso:FindFirstChild("Right Shoulder") or character:FindFirstChild("RightShoulder", true))
	local LeftShoulder = Torso and (Torso:FindFirstChild("Left Shoulder") or character:FindFirstChild("LeftShoulder", true))

	local originalRightC0 = RightShoulder and RightShoulder.C0 or nil
	local originalLeftC0 = LeftShoulder and LeftShoulder.C0 or nil

	local anims = {
		Idle = Instance.new("Animation"),
		Run  = Instance.new("Animation"),
		Fly  = Instance.new("Animation"),
		Land = Instance.new("Animation")
	}

	-- Universal verified fallback animation layers
	anims.Idle.AnimationId = "rbxassetid://181524222" 
	anims.Run.AnimationId  = "rbxassetid://180261368" 
	anims.Fly.AnimationId  = "rbxassetid://1144078604" 
	anims.Land.AnimationId = "rbxassetid://18130996"   

	local Animator = Humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", Humanoid)
	local tracks = {}
	pcall(function()
		for name, anim in pairs(anims) do
			tracks[name] = Animator:LoadAnimation(anim)
			tracks[name].Priority = Enum.AnimationPriority.Action3
		end
	end)

	local nativeAnimate = character:FindFirstChild("Animate")
	if nativeAnimate then nativeAnimate.Disabled = true; nativeAnimate:Destroy() end

	for _, track in ipairs(Animator:GetPlayingAnimationTracks()) do track:Stop(0) end

	local function playTrack(targetTrack)
		if not targetTrack then return end
		if currentTrack ~= targetTrack then
			if currentTrack then currentTrack:Stop(0.1) end
			currentTrack = targetTrack
			currentTrack.Looped = (targetTrack == tracks.Run or targetTrack == tracks.Idle or targetTrack == tracks.Fly)
			currentTrack:Play(0.1)
		else
			if currentTrack and not currentTrack.IsPlaying then currentTrack:Play(0) end
		end
	end
	physicsLoop = RunService.PostSimulation:Connect(function()
		if not character or not character:IsDescendantOf(workspace) or Humanoid.Health <= 0 then return end
		local isMidAir = (Humanoid.FloorMaterial == Enum.Material.Air)
		local horizontalVelocity = (RootPart.AssemblyLinearVelocity * Vector3.new(1, 0, 1)).Magnitude
		local isMoving = (Humanoid.MoveDirection.Magnitude > 0) and (horizontalVelocity > 0.8)
		
		if wasMidAir and not isMidAir and not isFlying then
			landingActive = true
			landingTime = os.clock()
		end
		wasMidAir = isMidAir 

		if landingActive and (os.clock() - landingTime > LAND_DURATION) then landingActive = false end

		if isFlying then
			landingActive = false
			playTrack(reachedPeakAltitude and tracks.Idle or tracks.Fly)
		elseif isMidAir then
			landingActive = false; playTrack(tracks.Fly)
		elseif landingActive then
			playTrack(tracks.Land)
		else
			if isMoving then
				playTrack(tracks.Run)
				if currentTrack and currentTrack == tracks.Run and currentTrack.IsPlaying then 
					currentTrack:AdjustSpeed(horizontalVelocity / 16) 
				end
			else
				playTrack(tracks.Idle)
			end
		end
	end)

	-- JOINT MOTOR CONTROLLER: Forcibly shapes R6 rig joints directly
	armJointLoop = RunService.Stepped:Connect(function(_, deltaTime)
		deltaTime = deltaTime or (1/60)
		if Humanoid.Health <= 0 or not RightShoulder or not LeftShoulder or not originalRightC0 or not originalLeftC0 then return end
		
		local horizontalVelocity = (RootPart.AssemblyLinearVelocity * Vector3.new(1, 0, 1)).Magnitude
		local isMovingOnGround = (Humanoid.FloorMaterial ~= Enum.Material.Air) and (Humanoid.MoveDirection.Magnitude > 0) and (horizontalVelocity > 0.8)

		if isFlying and not reachedPeakAltitude then
			-- 1. ASCENDING FLIGHT STATE: Arms pointed 90 degrees straight up to the sky
			armLiftProgress = math.min(1, armLiftProgress + (deltaTime * 5))
			local rightSky = originalRightC0 * CFrame.Angles(0, 0, math.rad(90))
			local leftSky = originalLeftC0 * CFrame.Angles(0, 0, math.rad(-90))
			RightShoulder.C0 = originalRightC0:Lerp(rightSky, armLiftProgress)
			LeftShoulder.C0 = originalLeftC0:Lerp(leftSky, armLiftProgress)
		elseif isMovingOnGround and not isFlying then
			-- 2. GROUND RUNNING STATE: Forcibly extend arms straight forward (Zombie/Robotic style)
			armLiftProgress = math.min(1, armLiftProgress + (deltaTime * 5))
			local rightZombie = originalRightC0 * CFrame.Angles(math.rad(-90), math.rad(-90), 0)
			local leftZombie = originalLeftC0 * CFrame.Angles(math.rad(-90), math.rad(90), 0)
			RightShoulder.C0 = originalRightC0:Lerp(rightZombie, armLiftProgress)
			LeftShoulder.C0 = originalLeftC0:Lerp(leftZombie, armLiftProgress)
		else
			-- 3. HOVERING/IDLE/RESTING STATES: Drop back smoothly to let default loops function
			armLiftProgress = math.max(0, armLiftProgress - (deltaTime * 5))
			RightShoulder.C0 = originalRightC0:Lerp(originalRightC0, armLiftProgress)
			LeftShoulder.C0 = originalLeftC0:Lerp(originalLeftC0, armLiftProgress)
		end
	end)

	local function createFlightUI()
		local existingGui = LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("FlightGui")
		if existingGui then existingGui:Destroy() end

		local screenGui = Instance.new("ScreenGui")
		screenGui.Name = "FlightGui"
		screenGui.ResetOnSpawn = true

		local button = Instance.new("TextButton")
		button.Name = "FlightButton"
		button.Size = UDim2.new(0, 120, 0, 50)
		button.Position = UDim2.new(0, 30, 1, -80)
		button.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
		button.TextColor3 = Color3.fromRGB(255, 255, 255)
		button.TextSize = 18
		button.Font = Enum.Font.SourceSansBold
		button.Text = "Flight: OFF"

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 8)
		corner.Parent = button
		button.Parent = screenGui
		screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

		button.MouseButton1Click:Connect(function()
			if not RootPart or Humanoid.Health <= 0 then return end
			if not isFlying then
				isFlying = true
				reachedPeakAltitude = false
				button.Text = "Flight: ON"
				button.BackgroundColor3 = Color3.fromRGB(180, 40, 40)

				RootPart.Anchored = true
				task.wait(1)
				if not RootPart or Humanoid.Health <= 0 then isFlying = false return end
				RootPart.Anchored = false
				if not isFlying then return end

				flightAttachment = Instance.new("Attachment")
				flightAttachment.Name = "FlightAttachment"
				flightAttachment.Parent = RootPart

				flightForce = Instance.new("LinearVelocity")
				flightForce.Name = "FlightForce"
				flightForce.Attachment0 = flightAttachment
				flightForce.MaxForce = math.huge
				flightForce.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
				flightForce.Parent = RootPart

				local targetYHeight = RootPart.Position.Y + 20

				flightMoveLoop = RunService.RenderStepped:Connect(function()
					if not isFlying or not RootPart or Humanoid.Health <= 0 then
						if flightMoveLoop then flightMoveLoop:Disconnect(); flightMoveLoop = nil end
						return
					end
					local moveDir = Humanoid.MoveDirection
					local verticalY = 0

					if not reachedPeakAltitude then
						if RootPart.Position.Y < targetYHeight then verticalY = 15 else reachedPeakAltitude = true end
					end

					flightForce.VectorVelocity = Vector3.new(moveDir.X * 19, verticalY, moveDir.Z * 19)
					targetPlayer = getClosestPlayer(RootPart) 
					
					if targetPlayer and targetPlayer:FindFirstChild("HumanoidRootPart") and targetPlayer.Humanoid.Health > 0 then
						local targetRoot = targetPlayer.HumanoidRootPart
						applyTargetDecal(targetPlayer)
						
						-- FIXED 3D CFRAME LIFT: Entire character model tilts up or drops down to physically look at the target in 3D
						RootPart.CFrame = CFrame.new(RootPart.Position, targetRoot.Position)
					else
						clearTargetDecal()
					end
				end)
			else
				reachedPeakAltitude = false
				button.Text = "Flight: OFF"
				button.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
				if flightForce then
					if flightMoveLoop then flightMoveLoop:Disconnect(); flightMoveLoop = nil end
					descentLoop = RunService.RenderStepped:Connect(function()
						if isFlying or not RootPart or Humanoid.Health <= 0 or Humanoid.FloorMaterial ~= Enum.Material.Air then
							if descentLoop then descentLoop:Disconnect(); descentLoop = nil end
							return
						end
						flightForce.VectorVelocity = Vector3.new(Humanoid.MoveDirection.X * 19, -5, Humanoid.MoveDirection.Z * 19)
						targetPlayer = getClosestPlayer(RootPart)
						if targetPlayer and targetPlayer:FindFirstChild("HumanoidRootPart") and targetPlayer.Humanoid.Health > 0 then
							local targetRoot = targetPlayer.HumanoidRootPart
							-- Maintain full 3D pitch alignment while descending
							RootPart.CFrame = CFrame.new(RootPart.Position, targetRoot.Position)
						end
					end)
					while not isFlying and Humanoid.FloorMaterial == Enum.Material.Air do RunService.Heartbeat:Wait() end
				end
				isFlying = false
				clearTargetDecal()
				targetPlayer = nil
				if flightForce then flightForce:Destroy(); flightForce = nil end
				if flightAttachment then flightAttachment:Destroy(); flightAttachment = nil end
				landingActive = true; landingTime = os.clock()
			end
		end)
	end
	createFlightUI()
end

if LocalPlayer.Character then task.spawn(initializeEngine, LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(function(newCharacter) initializeEngine(newCharacter) end)
