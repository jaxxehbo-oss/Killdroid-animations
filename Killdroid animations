local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local physicsLoop, armJointLoop, flightMoveLoop, descentLoop
local isFlying = false
local flightForce, flightAttachment, targetPlayer, targetDecal
local reachedPeakAltitude = false
local landingActive = false
local landingTime = 0
local LAND_DURATION = 0.4 
local currentTrack = nil
local wasMidAir = false
local armLiftProgress = 0

local LOCKON_IMAGE_ID = "rbxassetid://9073155799" 

local function getClosestPlayer(rootPart)
	local closest = nil
	local shortestDistance = math.huge
	if not rootPart then return nil end
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
			local distance = (rootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
			if distance < shortestDistance then
				shortestDistance = distance
				closest = p.Character
			end
		end
	end
	return closest
end

local function clearTargetDecal()
	if targetDecal then
		targetDecal:Destroy()
		targetDecal = nil
	end
end

local function applyTargetDecal(characterModel)
	clearTargetDecal()
	local head = characterModel:FindFirstChild("Head")
	if not head then return end
	targetDecal = Instance.new("Decal")
	targetDecal.Name = "KilldroidLockonDecal"
	targetDecal.Texture = LOCKON_IMAGE_ID
	targetDecal.Face = Enum.NormalId.Front 
	targetDecal.Parent = head
end

local function initializeEngine(character)
	if physicsLoop then physicsLoop:Disconnect(); physicsLoop = nil end
	if armJointLoop then armJointLoop:Disconnect(); armJointLoop = nil end
	if flightMoveLoop then flightMoveLoop:Disconnect(); flightMoveLoop = nil end
	if descentLoop then descentLoop:Disconnect(); descentLoop = nil end
	clearTargetDecal()
	isFlying = false
	reachedPeakAltitude = false

	local Humanoid = character:WaitForChild("Humanoid")
	local RootPart = character:WaitForChild("HumanoidRootPart")

	local Torso = character:WaitForChild("Torso", 5)
	local RightShoulder = Torso and Torso:WaitForChild("Right Shoulder", 5)
	local LeftShoulder = Torso and Torso:WaitForChild("Left Shoulder", 5)

	-- Hardcoded base offsets to decouple rotations from package shape variances
	local originalRightC0 = CFrame.new(1, 0.5, 0) * CFrame.Angles(0, math.pi/2, 0)
	local originalLeftC0 = CFrame.new(-1, 0.5, 0) * CFrame.Angles(0, -math.pi/2, 0)
	-- FIXED POSITION MOTOR ENGINE: Swings arms 90 degrees horizontally to face fully forward
	armJointLoop = RunService.Stepped:Connect(function()
		if Humanoid.Health <= 0 or not RightShoulder or not LeftShoulder then return end
		
		-- Override animation engine transformations completely
		RightShoulder.Transform = CFrame.new()
		LeftShoulder.Transform = CFrame.new()

		if isFlying and not reachedPeakAltitude then
			-- 1. ASCENDING FLIGHT STATE: Smoothly pivot arms up to face the sky
			armLiftProgress = math.min(1, armLiftProgress + (1/60 * 6))
			
			local rightSky = originalRightC0 * CFrame.Angles(0, 0, math.rad(90))
			local leftSky = originalLeftC0 * CFrame.Angles(0, 0, math.rad(-90))
			
			RightShoulder.C0 = originalRightC0:Lerp(rightSky, armLiftProgress)
			LeftShoulder.C0 = originalLeftC0:Lerp(leftSky, armLiftProgress)
		else
			-- 2. PARALLEL ZOMBIE RECONSTRUCTION: Corrected angles to rotate arms fully forward instead of outward
			armLiftProgress = math.max(0, armLiftProgress - (1/60 * 6))
			
			-- Multiplied matrices along the local Y axis to swing limbs completely frontward
			local rightZombie = originalRightC0 * CFrame.Angles(math.rad(-90), 0, math.rad(-90))
			local leftZombie = originalLeftC0 * CFrame.Angles(math.rad(-90), 0, math.rad(90))
			
			RightShoulder.C0 = originalRightC0:Lerp(rightZombie, 1 - armLiftProgress)
			LeftShoulder.C0 = originalLeftC0:Lerp(leftZombie, 1 - armLiftProgress)
		end
	end)

	local function createFlightUI()
		local existingGui = LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("FlightGui")
		if existingGui then existingGui:Destroy() end

		local screenGui = Instance.new("ScreenGui")
		screenGui.Name = "FlightGui"
		screenGui.ResetOnSpawn = true

		local button = Instance.new("TextButton")
		button.Name = "FlightButton"
		button.Size = UDim2.new(0, 120, 0, 50)
		button.Position = UDim2.new(0, 30, 1, -80)
		button.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
		button.TextColor3 = Color3.fromRGB(255, 255, 255)
		button.TextSize = 18
		button.Font = Enum.Font.SourceSansBold
		button.Text = "Flight: OFF"

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 8)
		corner.Parent = button
		button.Parent = screenGui
		screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

		button.MouseButton1Click:Connect(function()
			if not RootPart or Humanoid.Health <= 0 then return end
			if not isFlying then
				isFlying = true
				reachedPeakAltitude = false
				button.Text = "Flight: ON"
				button.BackgroundColor3 = Color3.fromRGB(180, 40, 40)

				RootPart.Anchored = true
				task.wait(1)
				if not RootPart or Humanoid.Health <= 0 then isFlying = false return end
				RootPart.Anchored = false
				if not isFlying then return end

				flightAttachment = Instance.new("Attachment")
				flightAttachment.Name = "FlightAttachment"
				flightAttachment.Parent = RootPart

				flightForce = Instance.new("LinearVelocity")
				flightForce.Name = "FlightForce"
				flightForce.Attachment0 = flightAttachment
				flightForce.MaxForce = math.huge
				flightForce.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
				flightForce.Parent = RootPart

				local targetYHeight = RootPart.Position.Y + 20

				flightMoveLoop = RunService.RenderStepped:Connect(function()
					if not isFlying or not RootPart or Humanoid.Health <= 0 then
						if flightMoveLoop then flightMoveLoop:Disconnect(); flightMoveLoop = nil end
						return
					end
					local moveDir = Humanoid.MoveDirection
					local verticalY = 0

					if not reachedPeakAltitude then
						if RootPart.Position.Y < targetYHeight then verticalY = 15 else reachedPeakAltitude = true end
					end

					flightForce.VectorVelocity = Vector3.new(moveDir.X * 19, verticalY, moveDir.Z * 19)
					targetPlayer = getClosestPlayer(RootPart) 
					
					if targetPlayer and targetPlayer:FindFirstChild("HumanoidRootPart") and targetPlayer.Humanoid.Health > 0 then
						local targetRoot = targetPlayer.HumanoidRootPart
						applyTargetDecal(targetPlayer)
						RootPart.CFrame = CFrame.new(RootPart.Position, targetRoot.Position)
					else
						clearTargetDecal()
					end
				end)
			else
				reachedPeakAltitude = false
				button.Text = "Flight: OFF"
				button.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
				if flightForce then
					if flightMoveLoop then flightMoveLoop:Disconnect(); flightMoveLoop = nil end
					descentLoop = RunService.RenderStepped:Connect(function()
						if isFlying or not RootPart or Humanoid.Health <= 0 or Humanoid.FloorMaterial ~= Enum.Material.Air then
							if descentLoop then descentLoop:Disconnect(); descentLoop = nil end
							return
						end
						flightForce.VectorVelocity = Vector3.new(Humanoid.MoveDirection.X * 19, -5, Humanoid.MoveDirection.Z * 19)
						targetPlayer = getClosestPlayer(RootPart)
						if targetPlayer and targetPlayer:FindFirstChild("HumanoidRootPart") and targetPlayer.Humanoid.Health > 0 then
							local targetRoot = targetPlayer.HumanoidRootPart
							RootPart.CFrame = CFrame.new(RootPart.Position, targetRoot.Position)
						end
					end)
					while not isFlying and Humanoid.FloorMaterial == Enum.Material.Air do RunService.Heartbeat:Wait() end
				end
				isFlying = false
				clearTargetDecal()
				targetPlayer = nil
				if flightForce then flightForce:Destroy(); flightForce = nil end
				if flightAttachment then flightAttachment:Destroy(); flightAttachment = nil end
				landingActive = true; landingTime = os.clock()
			end
		end)
	end
	createFlightUI()
end

if LocalPlayer.Character then task.spawn(initializeEngine, LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(function(newCharacter) initializeEngine(newCharacter) end)
